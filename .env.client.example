# Environment for ONE client's own copy of the platform.
# Copy to that deployment's env settings — never into this repo with values.
# See docs/new-client-deployment.md.

# ── Branding ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=Client Name
NEXT_PUBLIC_BRAND_PRODUCT=Finance OS
NEXT_PUBLIC_BRAND_DESCRIPTION=Payout reconciliation and books closing for Client Name.
DEFAULT_TENANT_ID=omnia            # internal id; leave as is in a separate copy

# ── Database: the client's OWN Supabase project ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=
DIRECT_URL=

# ── Security (generate fresh per client — never reuse Omnia's) ──────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OMNIA_SESSION_SECRET=
ZOHO_CREDENTIALS_KEY=
# Login passwords per role (admin, finance, …) — see lib/auth-config.ts
OMNIA_PW_ADMIN=
OMNIA_PW_FINANCE=

# ── Zoho ────────────────────────────────────────────────────────────────────
# PRIMARY organisation here (Zoho Self Client credentials, scope
# ZohoBooks.fullaccess.all). Background syncs and anything not tied to a
# payout use it. Add any further organisations in Settings → Zoho
# organisations (stored encrypted with ZOHO_CREDENTIALS_KEY).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_ORGANIZATION_LABEL=Client Company LLC
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.sa   (only if not on the .com data centre)
ZOHO_DAILY_BUDGET=4500

# ── Stores (only what this client has) ──────────────────────────────────────
SHOPIFY_STORE_CODES=MAIN           # comma-separated codes, e.g. MAIN,KSA
SHOPIFY_MAIN_URL=https://client.myshopify.com
SHOPIFY_MAIN_TOKEN=
# WOO_URL= / WOO_CONSUMER_KEY= / WOO_CONSUMER_SECRET=   (if on WooCommerce)

# ── Gateways (set only those the client uses) ───────────────────────────────
# STRIPE_SECRET_KEY=  TABBY_…  TAMARA_…  TELR_…   — see .env of the Omnia copy for names
